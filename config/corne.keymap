#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    combos {
        compatible = "zmk,combos";

        Colemak {
            bindings = <&tog 1>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | ALT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | GUI  |
            //                    | TAB | LWR | ENT |   | SPC | RSE  | ALT |

            bindings = <
&kp ESC               &kp Q  &kp W                   &kp E                 &kp R             &kp T        &kp Y            &kp U                &kp I      &kp O    &kp P     &kp DEL
&mt LEFT_CONTROL TAB  &kp A  &mt LA(LEFT_CONTROL) S  &mt LA(LEFT_SHIFT) D  &lt 3 F           &kp G        &kp H            &kp J                &kp K      &kp L    &kp SEMI  &mt RIGHT_CONTROL SQT
&kp LSHFT             &kp Z  &kp X                   &kp C                 &kp V             &kp B        &kp N            &kp M                &kp COMMA  &kp DOT  &kp FSLH  &mt RSHIFT BACKSLASH
                                                     &kp LWIN              &mt LEFT_ALT TAB  &lt 2 RET    &lt 3 BACKSPACE  &mt RIGHT_ALT SPACE  &kp RWIN
            >;
        };

        Colemak {
            display-name = "Colemak";
            bindings = <
&kp ESC               &kp Q  &kp W  &kp F     &kp P             &kp B        &kp J            &kp L                &kp U      &kp Y       &kp SEMICOLON  &kp DEL
&mt LEFT_CONTROL TAB  &kp A  &kp R  &kp S     &lt 3 T           &kp G        &kp M            &kp N                &kp E      &kp I       &kp O          &mt RIGHT_CONTROL SQT
&kp LSHFT             &kp Z  &kp X  &kp C     &kp D             &kp V        &kp K            &kp H                &kp COMMA  &kp PERIOD  &kp SLASH      &mt RSHIFT BACKSLASH
                                    &kp LWIN  &mt LEFT_ALT TAB  &lt 2 RET    &lt 3 BACKSPACE  &mt RIGHT_ALT SPACE  &kp RWIN
            >;

            label = "Colemak";
        };

        lower_layer {
            display-name = "LOW";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | LCTRL| BTCLR | BT0 | BT1 | BT2 | BT3 |   |     |     |  UP |     |     |      |
            // | ESC  |       | HOME| PGUP| PGDN| END |   |     | LFT | DWN | RGT |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&studio_unlock  &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1                      &bt BT_SEL 2     &bt BT_SEL 3       &kp INS        &kp HOME  &kp UP                &kp END                &kp MINUS         &kp EQUAL
&sys_reset      &kp LEFT_GUI     &kp LEFT_ALT     &kp LEFT_CONTROL                  &kp LSHIFT       &rgb_ug RGB_HUI    &kp PAGE_UP    &kp LEFT  &kp DOWN              &kp RIGHT              &kp LEFT_BRACE    &kp RIGHT_BRACE
&trans          &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD                   &rgb_ug RGB_BRI  &rgb_ug RGB_HUD    &kp PAGE_DOWN  &trans    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                                  &rgb_ug RGB_COLOR_HSB(297,86,35)  &trans           &trans             &mo 0          &trans    &trans
            >;
        };

        raise_layer {
            display-name = "RAI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |RGB_TOG|RGB_HUI|RGB_SAI|RGB_VAI|       |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |RGB_MOD|RGB_HUD|RGB_SAD|RGB_VAD|QK_BOOT|   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp N5           &kp F7   &kp N7  &kp N8      &kp N9  &kp F1  &kp F2
&kp CAPS        &kp NUMBER_6  &kp N7        &kp N8            &kp N9             &kp N0           &kp F8   &kp N4  &kp N5      &kp N6  &kp F3  &kp F4
&kp LEFT_SHIFT  &kp MINUS     &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH    &kp F9   &kp N1  &kp N2      &kp N3  &kp F5  &kp F6
                                            &trans            &kp LEFT_ALT       &mo 0            &kp RET  &kp N0  &kp KP_DOT
            >;
        };

        Media_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Media";
        };
    };
};
