#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    combos {
        compatible = "zmk,combos";

        Colemak {
            bindings = <&tog 1>;
            key-positions = <0 11>;
        };
    };

    behaviors {
        up_arrow: up_arrow {
            compatible = "zmk,behavior-mod-morph";
            label = "UP_ARROW";
            bindings = <&kp I>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        left_arrow: left_arrow {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_ARROW";
            bindings = <&kp J>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        down_arrow: down_arrow {
            compatible = "zmk,behavior-mod-morph";
            label = "DOWN_ARROW";
            bindings = <&kp K>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        right_arrow: right_arrow {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_ARROW";
            bindings = <&kp L>, <&kp RIGHT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        DT_TabEsc: DT_TabEsc {
            compatible = "zmk,behavior-tap-dance";
            label = "DT_TABESC";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp ESC>;

            tapping-term-ms = <200>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            require-prior-idle-ms = <125>;
            quick-tap-ms = <175>;
            retro-tap;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | ALT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | GUI  |
            //                    | TAB | LWR | ENT |   | SPC | RSE  | ALT |

            bindings = <
&DT_TabEsc  &kp Q                &kp W            &kp E              &kp R             &kp T        &kp Y          &kp U        &kp I      &kp O    &kp P     &kp DEL
&kp ESC     &HML LEFT_CONTROL A  &HML LEFT_ALT S  &HML LEFT_SHIFT D  &HML LEFT_GUI F   &lt 3 G      &kp H          &kp J        &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT   &kp Z                &kp X            &kp C              &kp V             &kp B        &kp N          &kp M        &kp COMMA  &kp DOT  &kp FSLH  &mt RSHIFT BACKSLASH
                                                  &kp LEFT_CONTROL   &mt LEFT_ALT TAB  &lt 2 RET    &kp BACKSPACE  &lt 3 SPACE  &kp RWIN
            >;
        };

        Colemak {
            display-name = "Colemak";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp F             &kp P             &kp B        &kp J            &kp L                &kp U      &kp Y       &kp SEMICOLON  &kp DEL
&kp ESC    &kp A  &kp R  &kp S             &lt 3 T           &kp G        &kp M            &kp N                &kp E      &kp I       &kp O          &kp APOSTROPHE
&kp LSHFT  &kp Z  &kp X  &kp C             &kp D             &kp V        &kp K            &kp H                &kp COMMA  &kp PERIOD  &kp SLASH      &mt RSHIFT BACKSLASH
                         &kp LEFT_CONTROL  &mt LEFT_ALT TAB  &lt 2 RET    &lt 3 BACKSPACE  &mt RIGHT_ALT SPACE  &kp RWIN
            >;

            label = "Colemak";
        };

        lower_layer {
            display-name = "LOW";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | LCTRL| BTCLR | BT0 | BT1 | BT2 | BT3 |   |     |     |  UP |     |     |      |
            // | ESC  |       | HOME| PGUP| PGDN| END |   |     | LFT | DWN | RGT |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &bt BT_CLR        &bt BT_SEL 0     &bt BT_SEL 1                      &bt BT_SEL 2     &bt BT_SEL 3       &kp INS        &kp HOME  &kp UP                &kp END                &kp MINUS         &kp EQUAL
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT     &kp LEFT_SHIFT                    &kp LEFT_GUI     &rgb_ug RGB_HUI    &kp PAGE_UP    &kp LEFT  &kp DOWN              &kp RIGHT              &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans  &rgb_ug RGB_TOG   &rgb_ug RGB_EFF  &rgb_ug RGB_BRD                   &rgb_ug RGB_BRI  &rgb_ug RGB_HUD    &kp PAGE_DOWN  &trans    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE
                                           &rgb_ug RGB_COLOR_HSB(297,86,35)  &trans           &trans             &trans         &mo 3     &trans
            >;
        };

        raise_layer {
            display-name = "RAI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |RGB_TOG|RGB_HUI|RGB_SAI|RGB_VAI|       |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |RGB_MOD|RGB_HUD|RGB_SAD|RGB_VAD|QK_BOOT|   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp N5           &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&kp CAPS        &trans        &trans        &trans            &trans             &trans           &trans        &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp MINUS     &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH    &trans        &trans  &trans  &trans  &trans  &kp RIGHT_SHIFT
                                            &trans            &kp LEFT_ALT       &trans           &trans        &trans  &trans
            >;
        };

        Media_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Media";
        };
    };
};
