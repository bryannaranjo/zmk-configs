#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";

        Colemak {
            bindings = <&tog 1>;
            key-positions = <0 11>;
        };
    };

    behaviors {
        uparrow_I: uparrow_I {
            compatible = "zmk,behavior-mod-morph";
            label = "UPARROW_I";
            bindings = <&kp I>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        leftarrow_J: leftarrow_J {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFTARROW_J";
            bindings = <&kp J>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        rightarrow_L: rightarrow_L {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHTARROW_L";
            bindings = <&kp L>, <&kp RIGHT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        downarrow_K: downarrow_K {
            compatible = "zmk,behavior-mod-morph";
            label = "DOWNARROW_K";
            bindings = <&kp K>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC         &kp N1  &kp N2              &kp N3          &kp N4            &kp N5                             &kp N6         &kp N7         &kp N8         &kp N9         &kp N0    &kp DEL
&kp TAB         &kp Q   &kp W               &kp E           &kp R             &kp T                              &kp Y          &kp U          &uparrow_I     &kp O          &kp P     &kp BACKSLASH
&kp CAPSLOCK    &kp A   &mt LEFT_CONTROL S  &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G                              &kp H          &leftarrow_J   &downarrow_K   &rightarrow_L  &kp SEMI  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z   &kp X               &kp C           &kp V             &kp B    &kp C_MUTE    &kp C_MUTE  &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH  &kp RSHIFT
                        &kp LCTRL           &kp LEFT_GUI    &kp LEFT_ALT      &kp TAB  &lt 2 RET     &kp SPACE   &kp BACKSPACE  &kp RIGHT_ALT  &kp RIGHT_GUI  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Colemak {
            display-name = "BAS";
            bindings = <
&kp ESC         &kp N1  &kp N2            &kp N3        &kp N4        &kp N5                                  &kp N6     &kp N7         &kp N8         &kp N9             &kp N0         &kp DEL
&kp TAB         &kp Q   &kp W             &kp F         &kp P         &kp B                                   &kp J      &kp L          &kp U          &kp Y              &kp SEMICOLON  &kp BACKSLASH
&kp CAPSLOCK    &kp A   &kp R             &kp S         &lt 3 T       &kp G                                   &kp M      &kp N          &kp E          &kp I              &kp O          &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z   &kp X             &kp C         &kp D         &kp V    &kp C_MUTE    &kp C_MUTE       &kp K      &kp H          &kp COMMA      &kp DOT            &kp FSLH       &kp RSHIFT
                        &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp TAB  &lt 2 RET     &lt 3 BACKSPACE  &kp SPACE  &kp RIGHT_ALT  &kp RIGHT_GUI  &kp RIGHT_CONTROL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;

            label = "CMKDH";
        };

        lower_layer {
            display-name = "LOW";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | `     |   1 |   2 |   3  |   4  |   5  |                   |   6  |   7   |   8   |   9  |    0  |  F12  |
            // |       |BTCLR| BT1 | BT2  | BT3  | BT4  |                   | LEFT | DOWN  |  UP   | RIGHT |  INS  |PRINTSCREEN|
            // |       |     | HOME| PGUP | PGDN | END  |        |  |       | UNDO |  CUT  | COPY  | PASTE |  DEL  |    BKSP   |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1          &kp F2           &kp F3           &kp F4           &kp F5           &kp F6                             &kp F7         &kp F8    &kp F9          &kp F10          &kp F11               &kp F12
&studio_unlock  &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3                       &kp INSERT     &kp HOME  &kp UP          &kp END          &kp MINUS             &kp EQUAL
&sys_reset      &kp LEFT_GUI     &kp LEFT_ALT     &kp LCTRL        &kp LEFT_SHIFT   &rgb_ug RGB_HUI                    &kp PAGE_UP    &kp LEFT  &kp DOWN        &kp RIGHT        &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans          &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_HUD  &trans    &trans  &kp PAGE_DOWN  &trans    &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
                                 &trans           &trans           &trans           &trans           &trans    &trans  &trans         &trans    &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "RAI";

            // ------------------------------------------------------------------------------------------------------------
            // |     |       |       |       |       |       |                |      |      |       |      |       |       |
            // |     |   !   |   @   |   #   |   $   |   %   |                |   ^  |  &   |   *   |   (  |   )   |       |
            // |     |RGB_TOG|RGB_HUI|RGB_SAI|RGB_BRI|       |                |   -  |   =  |   [   |   ]  |   \   | GRAVE |
            // |     |RGB_EFF|RGB_HUD|RGB_SAD|RGB_BRD|QK_BOOT|      |  |      |   _  |   +  |   {   |   }  |   |   |   ~   |
            //              |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &trans     &trans     &trans         &trans         &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp GRAVE  &kp PRCNT  &kp PIPE       &kp AMPS       &kp EQUAL                       &trans  &kp N7  &kp N8  &kp N9  &kp F1  &kp F2
&trans  &kp EXCL   &kp AT     &kp HASH       &kp DLLR       &kp LS(DOT)                     &trans  &kp N4  &kp N5  &kp N6  &kp F3  &kp F4
&trans  &kp CARET  &kp ASTRK  &kp LS(MINUS)  &kp LS(EQUAL)  &kp MINUS    &trans    &trans   &trans  &kp N1  &kp N2  &kp N3  &kp F5  &kp F6
                   &trans     &trans         &trans         &trans       &trans    &kp RET  &kp N0  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
